:root{--blue:#2563eb;--blue2:#1d4ed8;--dark:#020617;--slate:#0f172a;--muted:#64748b;--soft:#f1f5f9;--line:#e2e8f0;--white:#fff}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;color:var(--dark);background:#fff}a{color:inherit;text-decoration:none}.container{max-width:1180px;margin:0 auto;padding:0 24px}.header{position:sticky;top:0;z-index:50;background:rgba(2,6,23,.86);backdrop-filter:blur(18px);border-bottom:1px solid rgba(255,255,255,.08)}.nav{height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.logo{display:flex;align-items:center;gap:12px;color:#fff;font-weight:800;letter-spacing:.06em}.logo-mark{width:38px;height:38px;border-radius:14px;background:linear-gradient(135deg,var(--blue),#93c5fd);display:grid;place-items:center}.nav-links{display:flex;gap:28px;color:#cbd5e1}.nav-links a:hover{color:#fff}.nav-button,.button{display:inline-flex;align-items:center;justify-content:center;border-radius:18px;font-weight:750;transition:.2s}.nav-button{background:#fff;color:#020617;padding:12px 18px}.button{padding:16px 24px}.button.primary{background:var(--blue);color:#fff}.button.primary:hover{background:var(--blue2)}.button.light{background:#fff;color:#020617}.button.ghost{border:1px solid rgba(255,255,255,.18);color:#fff;background:rgba(255,255,255,.06)}.button.small{padding:12px 18px}.hero{position:relative;overflow:hidden;background:var(--slate);color:#fff}.hero-bg{position:absolute;inset:0;background:radial-gradient(circle at 20% 20%,rgba(37,99,235,.45),transparent 28%),linear-gradient(135deg,#0f172a,#020617 60%,#000)}.hero-grid{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:70px;align-items:center;min-height:760px;padding-top:80px;padding-bottom:90px}.badge{display:inline-flex;border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:999px;color:#dbeafe;padding:10px 16px;font-size:14px}.hero h1{font-size:clamp(44px,7vw,82px);line-height:.95;margin:28px 0 0;letter-spacing:-.05em}.hero h1::after{content:"";display:block;width:90px;height:5px;background:var(--blue);border-radius:20px;margin-top:28px}.hero-text{font-size:20px;line-height:1.7;color:#cbd5e1;max-width:680px}.hero-actions{display:flex;gap:14px;flex-wrap:wrap;margin-top:34px}.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px;max-width:580px}.stats strong{display:block;font-size:34px}.stats span{display:block;color:#94a3b8;margin-top:5px;font-size:14px}.image-card{position:relative;min-height:520px;border-radius:38px;background:#0f172a;border:1px solid rgba(255,255,255,.1);box-shadow:0 30px 90px rgba(0,0,0,.35);overflow:hidden}.image-card.tall{min-height:560px}.image-card:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,rgba(37,99,235,.55),rgba(2,6,23,.2),rgba(0,0,0,.88))}.image-shape{position:absolute;border-radius:36px;background:rgba(255,255,255,.13);filter:blur(.2px)}.image-shape.one{width:260px;height:170px;left:44px;top:60px;transform:rotate(-8deg)}.image-shape.two{width:190px;height:300px;right:34px;top:130px;background:rgba(96,165,250,.22);transform:rotate(10deg)}.image-label{position:absolute;left:34px;right:34px;bottom:34px;color:#fff}.image-label span{color:#93c5fd;text-transform:uppercase;letter-spacing:.28em;font-size:13px}.image-label h2{font-size:42px;line-height:1.06;margin:12px 0}.image-label p{color:#cbd5e1;line-height:1.55}.urgent{background:#0f172a;color:#fff;border-top:1px solid rgba(255,255,255,.08);border-bottom:1px solid rgba(255,255,255,.08)}.urgent-inner{display:flex;justify-content:space-between;align-items:center;gap:18px;padding-top:22px;padding-bottom:22px}.urgent p{margin:0;color:#cbd5e1;font-size:18px}.section{padding:96px 0}.light-section{background:var(--soft)}.dark-section{background:#020617;color:#fff}.blue-section{background:linear-gradient(135deg,#1d4ed8,#1e40af);color:#fff}.cards-four{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}.trust-card{background:#fff;border:1px solid var(--line);border-radius:28px;padding:28px;font-size:20px;font-weight:800;box-shadow:0 10px 30px rgba(15,23,42,.04)}.section-title span{display:block;color:var(--blue);text-transform:uppercase;letter-spacing:.22em;font-size:13px;font-weight:800}.section-title.inverse span{color:#93c5fd}.section-title h2{font-size:clamp(36px,5vw,58px);line-height:1.05;letter-spacing:-.04em;margin:12px 0 0}.section-title.centered{text-align:center}.service-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px}.service-card{border:1px solid var(--line);border-radius:30px;padding:30px;background:#fff;transition:.2s}.service-card:hover{box-shadow:0 25px 70px rgba(15,23,42,.12);transform:translateY(-4px)}.service-card h3{font-size:25px;margin:0}.service-card p{color:var(--muted);line-height:1.65}.service-card a,.blog-card a{color:var(--blue);font-weight:800}.two-col{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center}.lead{font-size:19px;line-height:1.75;color:#cbd5e1}.lead.dark{color:var(--muted)}.check-list{list-style:none;padding:0;margin:32px 0 0;display:grid;gap:17px}.check-list li{position:relative;padding-left:28px;font-size:18px;color:inherit}.check-list li:before{content:"";position:absolute;left:0;top:9px;width:11px;height:11px;background:var(--blue);border-radius:50%}.section-head-row{display:flex;justify-content:space-between;gap:40px;align-items:flex-end}.section-head-row p{max-width:520px;color:var(--muted);line-height:1.65;font-size:18px}.result-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px}.result-card{border:1px solid var(--line);background:#f8fafc;border-radius:30px;padding:34px}.result-card strong{display:block;color:var(--blue);font-size:46px}.result-card span{display:block;margin-top:10px;color:#334155;font-size:18px}.cta-center{text-align:center}.cta-center h2{font-size:clamp(38px,5vw,60px);line-height:1.05;margin:0}.cta-center p{font-size:20px;line-height:1.65;color:#dbeafe;max-width:760px;margin:22px auto 0}.quick-form{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin:42px auto 0;max-width:920px}.quick-form input,.contact-box input,.contact-box textarea{width:100%;border:0;border-radius:18px;padding:18px 20px;font-size:16px;outline:none}.quick-form button,.contact-box button{border:0;border-radius:18px;background:#020617;color:#fff;font-size:16px;font-weight:850;cursor:pointer;padding:18px 22px}.wide-text{max-width:760px;color:var(--muted);font-size:18px;line-height:1.65}.tags{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:42px}.tags span,.seo-grid div{background:#fff;border:1px solid var(--line);border-radius:24px;padding:22px;font-weight:800}.blog-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:52px}.blog-card{border:1px solid var(--line);border-radius:30px;overflow:hidden;background:#fff}.blog-card>div:last-child{padding:26px}.blog-card h3{font-size:24px;margin:0}.blog-card p{color:var(--muted);line-height:1.6}.blog-image{height:190px;background:linear-gradient(135deg,#dbeafe,#64748b 50%,#020617);position:relative}.blog-image:after{content:"";position:absolute;inset:32px;border:1px solid rgba(255,255,255,.4);border-radius:22px}.crm-panel{border:1px solid rgba(255,255,255,.12);background:rgba(255,255,255,.06);border-radius:34px;padding:28px}.crm-item{display:flex;justify-content:space-between;gap:16px;align-items:center;background:rgba(255,255,255,.08);border-radius:22px;padding:20px;margin-bottom:16px}.crm-item:last-child{margin-bottom:0}.crm-item span{display:block;color:#94a3b8;margin-top:5px}.crm-item em{font-style:normal;color:#93c5fd;font-weight:900}.seo-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:42px}.faq-wrap{max-width:900px}.faq-wrap details{background:#fff;border:1px solid var(--line);border-radius:24px;padding:26px;margin-top:16px}.faq-wrap summary{font-size:21px;font-weight:850;cursor:pointer}.faq-wrap p{color:var(--muted);line-height:1.6}.contacts{background:#fff}.contact-lines{margin-top:30px;font-size:18px}.messengers{display:flex;gap:14px;margin-top:28px}.messengers a{padding:16px 22px;border-radius:18px;background:#0f172a;color:#fff;font-weight:800}.messengers a:last-child{background:var(--blue)}.contact-box{background:#f8fafc;border:1px solid var(--line);border-radius:34px;padding:32px;box-shadow:0 25px 80px rgba(15,23,42,.08)}.contact-box h3{font-size:30px;margin:0 0 20px}.contact-box input,.contact-box textarea{border:1px solid var(--line);margin-bottom:12px;background:#fff}.contact-box textarea{min-height:130px;resize:vertical}.contact-box button{width:100%;background:var(--blue)}.form-note{font-size:13px;color:var(--muted);line-height:1.5}.form-status{font-weight:800;margin-top:10px}.footer{background:#000;color:#fff;padding:64px 0}.footer-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr 1fr;gap:40px}.footer h3,.footer h4{margin:0 0 16px}.footer p{color:#94a3b8;line-height:1.7}.footer-button{display:inline-flex;background:var(--blue);padding:16px 20px;border-radius:18px;font-weight:850}@media(max-width:900px){.nav-links{display:none}.hero-grid,.two-col{grid-template-columns:1fr}.hero-grid{min-height:auto}.cards-four,.service-grid,.result-grid,.tags,.blog-grid,.seo-grid,.footer-grid{grid-template-columns:1fr 1fr}.quick-form{grid-template-columns:1fr}.section-head-row{display:block}.image-card{min-height:420px}}@media(max-width:620px){.container{padding:0 18px}.nav{height:68px}.nav-button{display:none}.hero-grid{padding-top:70px;padding-bottom:70px}.stats,.cards-four,.service-grid,.result-grid,.tags,.blog-grid,.seo-grid,.footer-grid{grid-template-columns:1fr}.section{padding:70px 0}.hero h1{font-size:44px}.hero-actions .button{width:100%}.urgent-inner{display:block}.urgent-inner .button{margin-top:16px}.image-label h2{font-size:34px}}

async function sendForm(form) {
  const status = form.querySelector('.form-status') || document.createElement('div')
  if (!status.className) status.className = 'form-status'
  if (!status.parentNode) form.appendChild(status)
  status.textContent = 'Отправляем заявку...'
  const data = Object.fromEntries(new FormData(form).entries())
  try {
    const res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(data)
    })
    if (!res.ok) throw new Error('Request failed')
    status.textContent = 'Заявка отправлена. Мы свяжемся с вами.'
    form.reset()
  } catch (e) {
    status.textContent = 'Заявка сохранена на сайте. Напишите также в WhatsApp или Telegram.'
  }
}

document.querySelectorAll('.contact-form').forEach((form) => {
  form.addEventListener('submit', (event) => {
    event.preventDefault()
    sendForm(form)
  })
})
